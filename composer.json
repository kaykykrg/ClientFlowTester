{
    "name": "kayky/clientflow",
    "description": "ClientFlow legacy project for TDE",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "ClientFlow\\Api\\": "api/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClientFlow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --configuration phpunit.xml"
    }
}
